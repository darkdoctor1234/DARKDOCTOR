SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=darkdoctor
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Usually the same as CORS_ALLOWED_ORIGINS — only needs to differ in unusual setups.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SUPERADMIN_EMAIL=your-superadmin@email.com
SUPERADMIN_PASSWORD=your-superadmin-password

# Optional. Leave blank for local dev (falls back to Django's in-memory
# cache) AND for docker-compose (it sets REDIS_URL itself, pointing at the
# sibling `redis` container — see docker-compose.yml). Required in
# production once gunicorn runs more than one worker — see HANDOVER.md's
# deployment section for why. Only set this by hand for a managed provider
# outside docker-compose (e.g. ElastiCache):
# redis://:password@your-redis-host:6379/0
REDIS_URL=

# Optional. Leave AWS_STORAGE_BUCKET_NAME blank for local dev (media files
# are saved to backend/media/ on disk instead). Fill in the rest to store
# uploads (review images, college-change-request proof documents) in S3 or
# any S3-compatible provider (e.g. Supabase Storage) — required in
# production, since EC2's own disk doesn't survive a redeploy.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
# Leave both blank for real AWS S3. For a non-AWS S3-compatible provider,
# set AWS_S3_ENDPOINT_URL to its S3 API endpoint and AWS_S3_CUSTOM_DOMAIN to
# its public file-serving domain (these two are often different hosts —
# e.g. Supabase: endpoint is "<ref>.storage.supabase.co/storage/v1/s3",
# public domain is "<ref>.supabase.co/storage/v1/object/public/<bucket>").
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Optional. Leave EMAIL_HOST blank to just print verification emails to the
# server console instead of sending them (fine for local dev). Fill these in
# with your SMTP provider's details to send real email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Darkdoctor <no-reply@darkdoctor.app>
